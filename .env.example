# Copia este archivo como .env y ajusta los valores. El .env NUNCA se versiona.

# URL base sin barra final. En XAMPP sin VirtualHost: http://localhost/sigpat-otic/public
# Con VirtualHost apuntando a /public: http://sigpat-otic.local
APP_URL=http://localhost/sigpat-otic/public

# local = muestra errores detallados | production = errores solo en storage/logs/app.log
APP_ENV=local

# Clave de cifrado de las contraseñas de las cuentas Microsoft 365 (AES-256-GCM).
# Genérela con: php database/generar_app_key.php --escribir
# Use la MISMA clave en todos los servidores que compartan la base: si se cambia o se pierde,
# las contraseñas guardadas ya no se pueden descifrar.
APP_KEY=

# Correo saliente (envío de actas). Gmail / Google Workspace @caen.edu.pe:
#   1) En la cuenta remitente (p. ej. otic@caen.edu.pe) active la verificación en dos pasos.
#   2) Cree una "contraseña de aplicación" en https://myaccount.google.com/apppasswords
#      y póngala en MAIL_PASSWORD (16 caracteres, sin espacios). NO use la contraseña normal.
# Pruebe la configuración con: php database/probar_correo.php destino@caen.edu.pe
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# tls (STARTTLS, puerto 587) | ssl (puerto 465) | none
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="OTIC - CAEN-EPG"
MAIL_REPLY_TO=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sigpat_otic
DB_USER=root
DB_PASS=
