{
    "name": "caen-epg/sigpat-otic",
    "description": "SIGPAT-OTIC: Sistema de gestión patrimonial, licencias, mantenimiento e informes técnicos de la OTIC del CAEN-EPG",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-pdo_mysql": "*",
        "ext-zip": "*",
        "dompdf/dompdf": "^3.0",
        "phpmailer/phpmailer": "6.9",
        "phpoffice/phpword": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Core/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2.12"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
